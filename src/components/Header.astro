---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url?: string;
  name: string;
  icon?: string;
  disabled?: boolean;
};

type HeaderLogo = {
  src: string;
  alt: string;
  kind?: "seal" | "wordmark";
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
  logos?: HeaderLogo[];
}

const { title, authors, conference, notes, links, logos } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pb-28",
    hasBackground && (logos && logos.length > 0 ? "pt-36" : "pt-24"),
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,15,20,.48),rgba(7,15,20,.74))]" />
      </div>
    )
  }
  {
    logos && logos.length > 0 && (
      <div class="not-prose absolute top-5 left-5 z-20 flex max-w-[calc(100%-2.5rem)] items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-lg text-shadow-none sm:top-7 sm:left-8">
        {logos.map((logo, index) => (
          <>
            {index > 0 && <span class="h-10 w-px bg-zinc-200" />}
            <img
              class:list={[
                "m-0 block bg-white object-contain",
                logo.kind === "seal"
                  ? "h-12 w-12 sm:h-14 sm:w-14"
                  : "h-12 w-auto max-w-[11rem] sm:h-14 sm:max-w-[13rem]",
              ]}
              src={logo.src}
              alt={logo.alt}
              loading="eager"
              decoding="async"
            />
          </>
        ))}
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "prose-headings:text-white gap-10 text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <h1
      class="my-0 text-4xl leading-[1.08] font-semibold tracking-[-0.035em] sm:text-5xl"
    >
      {title}
    </h1>
    <div class="flex flex-row flex-wrap justify-center gap-x-6 gap-y-3">
      {
        authors.map((author) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-[1.05rem] font-medium">
              {author.url ? (
                <a
                  class:list={[
                    hasBackground &&
                      "not-prose text-blue-200 underline decoration-dashed underline-offset-4 hover:text-blue-100 hover:decoration-solid",
                  ]}
                  href={author.url}
                >
                  {author.name}
                </a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-sm">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && (
              <div class="text-xs opacity-80">{author.institution}</div>
            )}
          </div>
        ))
      }
    </div>
    {
      conference && (
        <div class="rounded-full border border-white/35 bg-black/20 px-4 py-1 text-sm font-semibold tracking-wide backdrop-blur-sm">
          {conference}
        </div>
      )
    }
    {
      notes && (
        <div class="text-center text-xs opacity-85">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) =>
            link.disabled ? (
              <span
                class:list={[
                  "flex cursor-default flex-row items-center gap-2 rounded-full px-5 py-2 text-lg",
                  hasBackground
                    ? "border border-white/35 bg-white/20 text-white backdrop-blur-sm text-shadow-none"
                    : "border border-zinc-300 bg-zinc-100 text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400",
                ]}
                aria-disabled="true"
              >
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
              </span>
            ) : (
              <a
                href={link.url}
                class:list={[
                  "flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                  hasBackground
                    ? "bg-white text-zinc-800 shadow-[0_0_8px_rgba(0,0,0,0.6)] text-shadow-none hover:bg-zinc-200"
                    : "bg-zinc-800 text-white hover:bg-black dark:bg-zinc-200 dark:text-zinc-900 dark:hover:bg-zinc-50",
                ]}
              >
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
              </a>
            ),
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
